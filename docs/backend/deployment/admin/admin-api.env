# 서버 배치 위치: /opt/deploy/projects/admin-api.env

PROJECT=admin-api
IMAGE=ghcr.io/namgyunkim/mono-repo/admin-api
PORT=8080
HEALTH_PATH=/api/health
HEALTH_TIMEOUT=60
SPRING_PROFILES=prod

# ALB Rolling 배포
TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:ap-northeast-2:ACCOUNT_ID:targetgroup/admin-api-tg/XXXXXXXXXX
DEREGISTER_TIMEOUT=120

# 로깅
LOG_FILE=/app/logs/app.log
LOG_ROLLING_PATTERN=/app/logs/app-%d{yyyy-MM-dd}.%i.log
LOG_MAX_HISTORY=30
LOG_MAX_FILE_SIZE=100MB
LOG_TOTAL_SIZE_CAP=3GB

# ===== 앱 환경변수 (DOCKER_ENV_ 접두사 → docker run -e 로 자동 전달) =====
# deploy.sh가 DOCKER_ENV_ 접두사를 제거하고 컨테이너에 주입한다.
# 변수명은 application-prod.yml의 ${...} 플레이스홀더와 1:1 대응한다.
# 예: DOCKER_ENV_DB_URL → -e DB_URL=... → application-prod.yml의 ${DB_URL}

# DB
DOCKER_ENV_DB_URL=jdbc:postgresql://<RDS_HOST>:5432/<DB_NAME>
DOCKER_ENV_DB_USERNAME=<DB_USER>
DOCKER_ENV_DB_PASSWORD=<DB_PASSWORD>

# Security
DOCKER_ENV_ENCRYPTION_SECRET=<ENCRYPTION_SECRET_KEY>

# S3 / AWS
DOCKER_ENV_S3_BUCKET=<S3_BUCKET_NAME>
DOCKER_ENV_AWS_ACCESS_KEY=<AWS_ACCESS_KEY_ID>
DOCKER_ENV_AWS_SECRET_KEY=<AWS_SECRET_ACCESS_KEY>

# Social Login (Google)
DOCKER_ENV_GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
DOCKER_ENV_GOOGLE_SECRET_KEY=<GOOGLE_SECRET_KEY>
DOCKER_ENV_GOOGLE_REDIRECT_URI=https://<API_DOMAIN>/api/social/v1/google/redirect
